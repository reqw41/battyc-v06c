diff -ruN a/routines/zx_field_frame.asm b/routines/zx_field_frame.asm
--- a/routines/zx_field_frame.asm	1970-01-01 05:00:00.000000000 +0500
+++ b/routines/zx_field_frame.asm	2026-10-13 01:03:21.000000000 +0500
@@ -0,0 +1,116 @@
+; ZX field frame in the three RGB planes: pipes and connectors, one bit per
+; pixel, coloured by two masks per material (see verify/generate-zx-frame.js).
+; A = bits & maskA, C = bits & maskC, E = ~bits | maskC.
+; Permanent graphics: drawn once per level, no per-frame repair.
+DrawFieldFrame:
+ ld a,1
+ ld (zf_mode+1),a ; top band: the masks are row patterns
+ ld hl,$c0e0
+ xor a
+zf_top:
+ ld (zf_top_index+1),a
+ cp 16
+ sbc a,a
+ cpl
+ ld (zf_mirror+1),a ; right half: mirrored cells in reverse order
+ ld a,(zf_top_index+1)
+ jp nz,zf_top_source
+ cpl
+ and 15
+zf_top_source:
+ push hl
+ ld e,a
+ ld d,0
+ ld hl,ZxFrameTopSeq
+ add hl,de
+ ld a,(hl)
+ ld c,a
+ and 3
+ add a,a
+ ld e,a
+ ld hl,ZxFrameTopMasks
+ add hl,de
+ ld a,(hl)
+ ld (zf_pattern_a),a
+ inc hl
+ ld a,(hl)
+ ld (zf_pattern_c),a
+ ld a,c
+ and $fc
+ add a,a
+ ld e,a
+ ld hl,ZxFrameTop
+ add hl,de
+ ex de,hl
+ pop hl
+ ld c,8
+ call zf_cell
+ ld l,$e0
+ inc h
+zf_top_index:
+ ld a,0
+ inc a
+ cp 32
+ jp nz,zf_top
+ xor a
+ ld (zf_mode+1),a ; side walls: plain bit masks
+ ld (zf_mirror+1),a
+ ld h,$c0
+ call zf_side
+ ld a,$ff
+ ld (zf_mirror+1),a
+ ld h,$df
+zf_side:
+ ld l,$d8
+ ld b,FieldHeight-8
+zf_side_wrap:
+ xor a
+zf_side_cell:
+ ld (zf_side_index+1),a
+ push hl
+ ld e,a
+ ld d,0
+ ld hl,ZxFrameSideSeq
+ add hl,de
+ ld a,(hl)
+ add a,a
+ ld hl,ZxFrameSideMasks
+ call hl_add_a
+ ld a,(hl)
+ ld (zf_mask_a+1),a
+ inc hl
+ ld a,(hl)
+ ld (zf_mask_c+1),a
+ ld (zf_mask_e+1),a
+ ld a,e
+ add a,a
+ add a,a
+ add a,a
+ ld e,a
+ ld hl,ZxFrameSide
+ add hl,de
+ ex de,hl
+ pop hl
+ ld a,b
+ cp 8
+ jp c,zf_side_rows
+ ld a,8
+zf_side_rows:
+ ld c,a
+ ld a,b
+ sub c
+ ld b,a
+ push bc
+ call zf_cell
+ pop bc
+ ld a,b
+ or a
+ ret z
+zf_side_index:
+ ld a,0
+ inc a
+ cp 7
+ jp nz,zf_side_cell
+ jp zf_side_wrap
+zf_pattern_a: db 0
+zf_pattern_c: db 0
diff -ruN a/RUSSIAN.md b/RUSSIAN.md
--- a/RUSSIAN.md	1970-01-01 05:00:00.000000000 +0500
+++ b/RUSSIAN.md	2026-10-13 01:52:45.000000000 +0500
@@ -0,0 +1,39 @@
+# Русская версия
+
+Ветка `experimental/russian`, дерево `wt/russian`. Основа — рабочее состояние `wt/three-plus-one` на вечер 12.10.2026 (ROM `8cf6c053…`, с ускорениями Codex). Поверх лежат перевод, новая раскраска магнитов (`MAGNETS.md`) и заготовка заставки (`gfx/splash`); итог сведения — в `MERGE.md`. Ничего не закоммичено. Патч для переноса в основное дерево: `RUSSIAN.patch` (`patch -p1 < ../russian/RUSSIAN.patch`, накладывается без конфликтов и даёт тот же ROM).
+
+## Что изменено
+
+- `gfx/font.asm` — знакогенератор: цифры, 32 русские буквы (без Ё), `. , пробел - =` и латинская Y для названия. 48 знаков вместо 43; `_` и `II` убраны как неиспользуемые. Коды: буквы `$0A–$29`, точка `$2A`, запятая `$2B`, пробел `$2C`, дефис `$2D`, `=` `$2E`, Y `$2F`.
+- `gfx/font.asm` — ещё десять знаков `$30–$39`: заголовки меню «ИГРОК 1» и «ИГРОК 2», сдвинутые на полуширину знака, чтобы стоять по центру над счётом.
+- `txt/*.asm` — все строки на русском, генерируются `python3 txt/make_txt.py`. Править текст нужно в генераторе.
+- `routines/record_table.asm` — ввод имени: пробел `$2C`, кольцо выбора 0–9, А–Я, `. , пробел -` (46 знаков).
+- `gfx/sprites_no_masks_2.asm` — надписи меню «ЖМИ А» и «ЖМИ Б» вместо PRESS A / PRESS B (клавиша с латинской B на Векторе — это Б).
+- `verify/generate-mono-assets.js` — заголовки HUD: «ИГРОК 1», «ИГРОК 2» (7 знаков) и «РЕКОРД» (6 знаков), каждый стоит по центру над своим счётом (X = 12, 188 и 104).
+- `verify/test-menu-selection.js` — сверка с русскими строками вместо английского эталонного ROM.
+- `verify/test-russian-name-entry.js` — новый: кольцо из 46 знаков, заворот в обе стороны, снимок экрана.
+
+Позиции цифр, которые код вписывает в строки (номер игрока, номер раунда), сохранены: смещения в `batty.asm` не менялись, сам `batty.asm` не тронут.
+
+## Строки
+
+| Было | Стало |
+|---|---|
+| 1 UP / 2 UP | ИГРОК 1 / ИГРОК 2 |
+| 1 - 1 PLAYER | 1 - 1 ИГРОК |
+| 2 - 2 PLAYERS | 2 - 2 ИГРОКА |
+| 3 - DOUBLE PLAY | 3 - ВДВОЕМ |
+| 0 - START GAME | 0 - НАЧАТЬ ИГРУ |
+| KEYBOARD / JOYSTICK | КЛАВИШИ / ДЖОЙСТИК |
+| COPYRIGHT HIT PAK 1987 | ХИТ ПАК 1987 |
+| PLAYER X / GAME ON / ROUND XX | ИГРОК X / ИГРАЕМ / РАУНД XX |
+| GAME OVER / PLAYER 0 / PLAYERS 1 AND 2 | КОНЕЦ ИГРЫ / ИГРОК 0 / ИГРОКИ 1 И 2 |
+| ENTER YOUR NAME. | ВВЕДИТЕ ВАШЕ ИМЯ |
+| HIGH SCORES, H I T / P A K | РЕКОРДЫ, Х И Т / П А К |
+| HUD: 1UP, 2UP, HI | ИГРОК 1, ИГРОК 2, РЕКОРД |
+
+Название BATTY оставлено латиницей.
+
+## Проверка
+
+`sh build-three-plus-one.sh`; ROM 32512 байт. Состав проверок и замеры — в `MERGE.md`. `test-mono-hud` падает и в основе (сравнивает с исходным файлом спрайтов), к переводу не относится.
diff -ruN a/txt/make_txt.py b/txt/make_txt.py
--- a/txt/make_txt.py	1970-01-01 05:00:00.000000000 +0500
+++ b/txt/make_txt.py	2026-10-13 01:49:01.000000000 +0500
@@ -0,0 +1,77 @@
+#!/usr/bin/env python3
+"""Генерирует txt/*.asm из русских строк. Запуск из корня дерева: python3 txt/make_txt.py
+Кодировка знакогенератора (gfx/font.asm): 0-9, А-Я без Ё ($0A-$29), '.', ',', ' ', '-', '=', Y.
+Формат сообщения: X, Y, цвет, длина, текст."""
+import os
+
+ALPHABET = "0123456789АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ., -=Y"
+# BATTY и подобное набирается похожими русскими буквами
+LATIN = str.maketrans("ABEKMHOPCTX", "АВЕКМНОРСТХ")
+
+
+# Заголовки меню: восемь ячеек знаков $30-$39, «ИГРОК n» со сдвигом на 4 точки (см. gfx/font.asm)
+HEADINGS = {"\u2460": [0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37],
+            "\u2461": [0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x38, 0x39]}
+
+
+def enc(text):
+    if text in HEADINGS:
+        return HEADINGS[text]
+    return [ALPHABET.index(ch) for ch in text.translate(LATIN)]
+
+
+def msg(x, y, color, text):
+    codes = enc(text)
+    out = ["  DEFB $%02X,$%02X,%s,$%02X" % (x, y, color, len(codes))]
+    for i in range(0, len(codes), 8):
+        line = "  DEFB " + ",".join("$%02X" % c for c in codes[i:i + 8])
+        out.append(line + ("\t; " + text if i == 0 else ""))
+    return "\n".join(out) + "\n"
+
+
+def table():
+    rows = []
+    ys = [0x27, 0x38, 0x49, 0x5A, 0x6B, 0x7C, 0x8D, 0x9E, 0xAF, 0xC0]
+    bright = ["c47", "c47", "c46", "c46", "c45", "c45", "c44", "c44", "c43", "c43"]
+    for i, y in enumerate(ys):
+        rows.append(msg(0x30 if i == 9 else 0x38, y, bright[i], "%d." % (i + 1)))
+    colors = ["c47", "c07", "c46", "c06", "c45", "c05", "c44", "c04", "c43", "c03"]
+    for i, y in enumerate(ys):
+        name = "Х И Т" if i % 2 == 0 else "П А К"
+        rows.append(msg(0x58, y, colors[i], "%06d   %s" % ((10 - i) * 10000, name)))
+    return rows
+
+
+FILES = {
+    "txt_main_menu": [msg(0x08, 0x01, "c07", "\u2460"), msg(0xB8, 0x01, "c07", "\u2461")],
+    "txt_score_1up": [msg(0x10, 0x09, "c07", "000000")],
+    "txt_score_2up": [msg(0xC0, 0x09, "c07", "000000")],
+    "txt_1_player": [msg(0x50, 0x29, "c44", "1 - 1 ИГРОК")],
+    "txt_2_players": [msg(0x50, 0x3D, "c44", "2 - 2 ИГРОКА")],
+    "txt_double_play": [msg(0x50, 0x51, "c44", "3 - ВДВОЕМ"),
+                        msg(0x50, 0xB1, "c44", "0 - НАЧАТЬ ИГРУ")],
+    "txt_controls": [msg(0x60, 0x7D, "c45", "КЛАВИШИ"),
+                     msg(0x60, 0x95, "c45", "ДЖОЙСТИК"),
+                     msg(0x50, 0xC9, "c47", "ХИТ ПАК 1987"),
+                     msg(0x70, 0x01, "c47", "BATTY"),
+                     msg(0x70, 0x08, "c46", "=====")],
+    # цифра игрока вписывается кодом в последний знак (txt_player_x+11)
+    "txt_player_x": [msg(0x58, 0x8F, "c47", " ИГРОК 0")],
+    # номер раунда вписывается в два последних знака (txt_round_xx+10,+11)
+    "txt_round_xx": [msg(0x60, 0x9E, "c47", "РАУНД 00")],
+    "txt_game_on": [msg(0x68, 0x8F, "c47", "ИГРАЕМ")],
+    "txt_game_over": [msg(0x58, 0x8F, "c47", "КОНЕЦ ИГРЫ")],
+    # цифра игрока вписывается в последний знак (txt_player_0+$0C)
+    "txt_player_0": [msg(0x50, 0x9E, "c47", "  ИГРОК 0")],
+    "txt_players_1_and_2": [msg(0x50, 0x9E, "c47", "ИГРОКИ 1 И 2")],
+    # цифра игрока вписывается в десятый знак (txt_player_0_enter_your_name+13)
+    "txt_player_0_enter_your_name": [msg(0x50, 0x01, "c47", "   ИГРОК 0  "),
+                                     msg(0x40, 0x09, "c47", "ВВЕДИТЕ ВАШЕ ИМЯ")],
+    "txt_high_score_table": table(),
+    "txt_high_scores": [msg(0x68, 0x01, "c47", "РЕКОРДЫ"), msg(0x68, 0x08, "c46", "=======")],
+}
+
+here = os.path.dirname(os.path.abspath(__file__))
+for name, parts in FILES.items():
+    with open(os.path.join(here, name + ".asm"), "w", encoding="utf-8") as f:
+        f.write(name + ":\n\n" + "\n".join(parts))
